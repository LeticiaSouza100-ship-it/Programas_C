#include<stdio.h>
#include<math.h>
int main (){
    float num1,num2,soma,subtracao,multiplicacao,divisao;
    int op;
    printf ("-----MENU-----\n");
    printf ("1 - Somar dois numeros\n");
    printf ("2 - Subtrair dois numeros\n");
    printf ("3 - Multiplicar dois numeros\n");
    printf ("4 - Dividir dois numeros\n");
    printf ("Digite sua opcao: ");
    scanf ("%d",&op);

    switch (op){
    case 1:
        printf ("Digite o primeiro numero: ");
        scanf ("%f",&num1);

        printf ("Digite o segundo numero: ");
        scanf ("%f",&num2);

        soma = num1 + num2;
        printf ("A soma de %.2f + %.2f = %.2f \n", num1, num2, soma);
        break;

    case 2:
        printf ("Digite o primeiro numero: ");
        scanf ("%f",&num1);

        printf ("Digite o segundo numero: ");
        scanf ("%f",&num2);

        subtracao = num1 - num2;
        printf ("A subtracao de %.2f - %.2f = %.2f \n",num1,num2,subtracao);
        break;

    case 3:
        printf ("Digite o primeiro numero: ");
        scanf ("%f",&num1);

        printf ("Digite o segundo numero: ");
        scanf ("%f",&num2);

        multiplicacao = num1 * num2;
        printf ("A multiplicacao de %.2f * %.2f = %.2f \n", num1,num2,multiplicacao);
        break;

    case 4:
        printf ("Digite a primeiro numero: ");
        scanf ("%f",&num1);

        printf ("Digite o segundo numero: ");
        scanf ("%f",&num2);

        divisao = num1 / num2;
        printf ("A divisao de %.2f / %.2f = %.2f \n",num1,num2,divisao);
        break;

    default:
    printf ("Opcao Invalida!\n");
    }
    return 0;
}
